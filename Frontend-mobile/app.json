{
  "expo": {
    "name": "ParKing",
    "slug": "parKing",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./img/logo_parking_sin_titulo.png",
    "resizeMode":"contain",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./img/logo_parking.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A3E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./img/logo_parking_sin_titulo.png",
        "backgroundColor": "#1E3A3E",
        "resizeMode":"contain"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Frontendmobile"
    },
    "web": {
      "favicon": "./img/logo_parking_sin_fondo.png"
    }
  }
}
